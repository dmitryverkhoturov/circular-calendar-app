<?xml version="1.0" encoding="utf-8"?>
<!-- Форма по SPEC: три сектора месяцев (90° суммарно), перевёрнуто —
     вершина сверху, дуги внизу; стрелка «сейчас» вниз посередине.
     Цвета — под дизайн «Сумерки»: фуксия с градиентом от вершины к дуге
     (как кольцо от дырки к краю), светлый обод, тёплая стрелка. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Левый сектор -->
    <path android:pathData="M54,33 L42.42,73.37 A42,42 0 0 1 24.82,63.21 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="54" android:centerY="33" android:gradientRadius="42">
                <item android:offset="0.0" android:color="#40A8287A"/>
                <item android:offset="0.6" android:color="#D0862A82"/>
                <item android:offset="1.0" android:color="#FF8E2C86"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Средний сектор (светлее) -->
    <path android:pathData="M54,33 L64.16,73.75 A42,42 0 0 1 43.84,73.75 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="54" android:centerY="33" android:gradientRadius="42">
                <item android:offset="0.0" android:color="#50C2357F"/>
                <item android:offset="0.6" android:color="#E0A8327F"/>
                <item android:offset="1.0" android:color="#FFB83E92"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Правый сектор -->
    <path android:pathData="M54,33 L83.18,63.21 A42,42 0 0 1 65.58,73.37 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="54" android:centerY="33" android:gradientRadius="42">
                <item android:offset="0.0" android:color="#40A8287A"/>
                <item android:offset="0.6" android:color="#D0862A82"/>
                <item android:offset="1.0" android:color="#FF8E2C86"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Обод по дугам -->
    <path android:strokeColor="#FFE58BC8" android:strokeWidth="1.1" android:strokeLineCap="round"
        android:pathData="M42.42,73.37 A42,42 0 0 1 24.82,63.21 M64.16,73.75 A42,42 0 0 1 43.84,73.75 M83.18,63.21 A42,42 0 0 1 65.58,73.37"/>

    <!-- Стрелка «сейчас» — вниз, остриё за дугами -->
    <path
        android:fillColor="#FFFFB84D"
        android:pathData="M53.2,33 L54.8,33 L54.8,76.5 L54,81 L53.2,76.5 Z"/>
</vector>
